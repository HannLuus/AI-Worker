# Studio (operators): configure in your VPS Supabase Studio for this project
# In Studio: Authentication → URL configuration — set Site URL (e.g. http://localhost:5173 or your Vercel origin)
# and Redirect URLs for every app origin + auth callbacks (see PLATFORM_INTEGRATION.md).

# Direct Postgres (MCP SQL tools + ./scripts/supabase-db.sh). Use compose/tunnel host; not the public API URL.
# Example: postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Edge Function Secrets
# Set via: Supabase Dashboard > Project Settings > Edge Functions > Secrets
# or CLI: supabase secrets set OPENROUTER_API_KEY=xxx
OPENROUTER_API_KEY=your_openrouter_api_key_here
RESEND_API_KEY=your_resend_api_key_here
CRON_SECRET=aicoworker-cron-secret-2026

# Stripe (Phase 5)
